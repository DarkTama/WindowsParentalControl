<Window x:Class="ParentalControl.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:ParentalControl.Admin.ViewModels"
        xmlns:views="clr-namespace:ParentalControl.Admin.Views"
        Icon="pack://application:,,,/icon.ico"
        Title="Parental Control - Administration"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UserDetailViewModel}">
            <views:UserDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1e293b" Padding="12,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Dashboard"
                            Command="{Binding ShowDashboardCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="White" Height="28" Padding="12,2" Margin="0,0,4,0" />
                    <Button Content="⚙️ Settings"
                            Command="{Binding ShowSettingsCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="White" Height="28" Padding="12,2" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ServiceStatusText}"
                               Foreground="{Binding ServiceStatusColor}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                    <md:PackIcon Kind="CircleSmall" Width="14" Height="14"
                                 Foreground="{Binding ServiceStatusColor}"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsServiceRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <md:PackIcon Kind="Close" Width="11" Height="11"
                                 Foreground="{Binding ServiceStatusColor}"
                                 VerticalAlignment="Center"
                                 Margin="2,0,0,0">
                        <md:PackIcon.Style>
                            <Style TargetType="md:PackIcon">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServiceRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </md:PackIcon.Style>
                    </md:PackIcon>
                </StackPanel>
            </DockPanel>
        </Border>
        <ContentControl Content="{Binding CurrentView}" />
    </DockPanel>
</Window>
