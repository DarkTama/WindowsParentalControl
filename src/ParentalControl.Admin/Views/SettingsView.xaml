<UserControl x:Class="ParentalControl.Admin.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

    <DockPanel>
        <!-- Back button bar -->
        <Border DockPanel.Dock="Top" Padding="8,4">
            <Button Command="{Binding GoBackCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="ArrowLeft" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Back to Dashboard" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,8,16,16" MaxWidth="800" HorizontalAlignment="Left">

                <!-- ═══ Telegram Notification Settings ═══ -->
                <md:ColorZone Mode="PrimaryMid" Padding="8,6" CornerRadius="4" Margin="0,0,0,8">
                    <TextBlock Text="Telegram Mobile Notifications"
                               FontSize="14" FontWeight="DemiBold"
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                               VerticalAlignment="Center" />
                </md:ColorZone>

                <md:Card Padding="20" Margin="0,0,0,24" md:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <TextBlock Text="Configure a Telegram Bot to receive screen time extension requests with 1-tap Approve/Decline buttons on your phone."
                                   TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,16" />

                        <TextBox md:HintAssist.Hint="Telegram Bot Token (from @BotFather)"
                                 md:HintAssist.IsFloating="True"
                                 Text="{Binding TelegramBotToken, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,12" />

                        <TextBox md:HintAssist.Hint="Telegram Chat ID (your private chat ID)"
                                 md:HintAssist.IsFloating="True"
                                 Text="{Binding TelegramChatId, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,16" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Test Telegram Alert"
                                    Command="{Binding TestTelegramCommand}"
                                    Style="{StaticResource MaterialDesignPaperButton}"
                                    Margin="0,0,12,0" />
                            <TextBlock Text="{Binding TestStatus}" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </md:Card>

                <!-- ═══ In-Session Warning Intervals ═══ -->
                <md:ColorZone Mode="PrimaryMid" Padding="8,6" CornerRadius="4" Margin="0,0,0,8">
                    <TextBlock Text="In-Session Warning Intervals"
                               FontSize="14" FontWeight="DemiBold"
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                               VerticalAlignment="Center" />
                </md:ColorZone>

                <md:Card Padding="20" Margin="0,0,0,24" md:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <TextBlock Text="Minutes remaining when unskippable popup alerts will be displayed inside the user's active session (comma-separated)."
                                   TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,16" />

                        <TextBox md:HintAssist.Hint="Alert Intervals (e.g. 15,5,1)"
                                 md:HintAssist.IsFloating="True"
                                 Text="{Binding AlertIntervals, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                    </StackPanel>
                </md:Card>

                <!-- ═══ Authenticator TOTP Security ═══ -->
                <md:ColorZone Mode="PrimaryMid" Padding="8,6" CornerRadius="4" Margin="0,0,0,8">
                    <TextBlock Text="Web Admin Authenticator 2FA (RFC 6238 TOTP)"
                               FontSize="14" FontWeight="DemiBold"
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                               VerticalAlignment="Center" />
                </md:ColorZone>

                <md:Card Padding="20" Margin="0,0,0,24" md:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <CheckBox Content="Enable Authenticator 2FA for Web Admin (port 5050)"
                                  IsChecked="{Binding IsTotpEnabled}"
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,16" />

                        <Button Content="Generate New Authenticator Secret"
                                Command="{Binding GenerateTotpSecretCommand}"
                                HorizontalAlignment="Left"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,0,12" />

                        <TextBox md:HintAssist.Hint="Secret Key (Base32)"
                                 md:HintAssist.IsFloating="True"
                                 Text="{Binding TotpSecret, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,12" />

                        <TextBox md:HintAssist.Hint="Authenticator Setup URI (otpauth://...)"
                                 md:HintAssist.IsFloating="True"
                                 Text="{Binding TotpUri}"
                                 IsReadOnly="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                    </StackPanel>
                </md:Card>

                <!-- ═══ Save Button ═══ -->
                <Button Content="Save All Settings"
                        Command="{Binding SaveSettingsCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        HorizontalAlignment="Left"
                        Padding="32,10" Margin="0,8,0,0" />

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
