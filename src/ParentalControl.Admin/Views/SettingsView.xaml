<UserControl x:Class="ParentalControl.Admin.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <DockPanel>
        <!-- Back button bar -->
        <Border DockPanel.Dock="Top" Padding="8,4">
            <Button Command="{Binding GoBackCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="ArrowLeft" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Back to Dashboard" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
            <StackPanel Margin="16,8,16,24" MaxWidth="820" HorizontalAlignment="Left">

                <!-- ═══ Telegram Notification Settings ═══ -->
                <md:ColorZone Mode="PrimaryMid" Padding="10,8" CornerRadius="4" Margin="0,0,0,8">
                    <TextBlock Text="📱 Telegram Remote Alerts &amp; Instant Approval"
                               FontSize="14" FontWeight="DemiBold"
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                               VerticalAlignment="Center" />
                </md:ColorZone>

                <md:Card Padding="20" Margin="0,0,0,24" md:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <TextBlock Text="Receive instant push notifications on your phone whenever a child requests extra screen time, and approve or decline with a single tap using Telegram inline buttons."
                                   TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,16" LineHeight="20" />

                        <TextBox md:HintAssist.Hint="Telegram Bot Token (obtained from @BotFather)"
                                 md:HintAssist.IsFloating="True"
                                 Text="{Binding TelegramBotToken, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     md:HintAssist.Hint="Admin Telegram Chat ID (numeric ID e.g. 940007183 — not @username)"
                                     md:HintAssist.IsFloating="True"
                                     Text="{Binding TelegramChatId, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Margin="0,0,8,0" />
                            <Button Grid.Column="1"
                                    Content="Detect ID"
                                    ToolTip="Queries your bot for your numeric Telegram ID after you send /start"
                                    Command="{Binding DetectChatIdCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <Border Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,4,0,16">
                            <StackPanel>
                                <TextBlock Text="💡 Quick Setup Guide:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="#1e293b" />
                                <TextBlock Text="1. In Telegram, search for @BotFather and send /newbot to create your bot and get the Bot Token." FontSize="11" Foreground="#475569" Margin="0,0,0,2" />
                                <TextBlock Text="2. Open your new bot in Telegram, tap Start (or send /start)." FontSize="11" Foreground="#475569" Margin="0,0,0,2" />
                                <TextBlock Text="3. Paste the Bot Token above and click 'Detect ID' to automatically retrieve your numeric Chat ID." FontSize="11" Foreground="#475569" />
                            </StackPanel>
                        </Border>

                        <!-- Session Event Notification Toggles -->
                        <TextBlock Text="🔔 Session Notification Options:" FontWeight="SemiBold" FontSize="13" Margin="0,4,0,8" Foreground="#1e293b" />
                        <StackPanel Margin="0,0,0,16">
                            <CheckBox Content="Notify on User Sign In (Restricted Accounts)"
                                      IsChecked="{Binding TelegramNotifySignIn}"
                                      Margin="0,0,0,6" />
                            <CheckBox Content="Notify on User Sign Out (Restricted Accounts)"
                                      IsChecked="{Binding TelegramNotifySignOut}"
                                      Margin="0,0,0,6" />
                            <CheckBox Content="Security Alert on Administrator Sign In (Unrestricted Accounts)"
                                      IsChecked="{Binding TelegramNotifyAdminLogon}"
                                      Margin="0,0,0,4" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Test Telegram Alert"
                                    Command="{Binding TestTelegramCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Margin="0,0,12,0" />
                            <TextBlock Text="{Binding TestStatus}" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </md:Card>

                <!-- ═══ In-Session Warning Intervals ═══ -->
                <md:ColorZone Mode="PrimaryMid" Padding="10,8" CornerRadius="4" Margin="0,0,0,8">
                    <TextBlock Text="⏱️ In-Session Warning Intervals"
                               FontSize="14" FontWeight="DemiBold"
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                               VerticalAlignment="Center" />
                </md:ColorZone>

                <md:Card Padding="20" Margin="0,0,0,24" md:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <TextBlock Text="Minutes remaining when native, unskippable Win32 popup alerts appear inside the child's active Windows desktop session. Popups display above games and full-screen applications."
                                   TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,16" LineHeight="20" />

                        <TextBox md:HintAssist.Hint="Alert Intervals in minutes, comma-separated (e.g. 15,5,1)"
                                 md:HintAssist.IsFloating="True"
                                 Text="{Binding AlertIntervals, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,8" />

                        <TextBlock Text="Example: '15,5,1' triggers native system alerts when 15 minutes, 5 minutes, and 1 minute remain before forced logout or curfew."
                                   FontSize="11" Opacity="0.6" />
                    </StackPanel>
                </md:Card>

                <!-- ═══ Screen Time Request Limits ═══ -->
                <md:ColorZone Mode="PrimaryMid" Padding="10,8" CornerRadius="4" Margin="0,0,0,8">
                    <TextBlock Text="🛡️ Daily Extension Request Limits"
                               FontSize="14" FontWeight="DemiBold"
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                               VerticalAlignment="Center" />
                </md:ColorZone>

                <md:Card Padding="20" Margin="0,0,0,24" md:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <TextBlock Text="Controls how many times a restricted child account is permitted to submit an extension request per calendar day. Set to 0 to completely disallow extra time requests."
                                   TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,16" LineHeight="20" />

                        <TextBox md:HintAssist.Hint="Max Daily Requests Per User (e.g. 1)"
                                 md:HintAssist.IsFloating="True"
                                 Text="{Binding MaxDailyRequests, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,8" />

                        <TextBlock Text="Default is 1. If child already has a pending or resolved request, portal enforces this daily ceiling."
                                   FontSize="11" Opacity="0.6" />
                    </StackPanel>
                </md:Card>

                <!-- ═══ Customizable Messages & Presets ═══ -->
                <md:ColorZone Mode="PrimaryMid" Padding="10,8" CornerRadius="4" Margin="0,0,0,8">
                    <TextBlock Text="💬 User Notifications &amp; Alert Messages"
                               FontSize="14" FontWeight="DemiBold"
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                               VerticalAlignment="Center" />
                </md:ColorZone>

                <md:Card Padding="20" Margin="0,0,0,24" md:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <TextBlock Text="Customize all dialog messages shown to restricted child sessions. Placeholders like {minutes} and {curfew_end} are dynamically replaced at runtime."
                                   TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,14" LineHeight="20" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Language Presets:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0" />
                            <Button Content="🇮🇩 Bahasa Indonesia Preset"
                                    Command="{Binding ApplyPresetIdCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Margin="0,0,8,0" />
                            <Button Content="🇬🇧 English Preset"
                                    Command="{Binding ApplyPresetEnCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </StackPanel>

                        <!-- Peringatan Batas Waktu Layar -->
                        <TextBox md:HintAssist.Hint="Quota Warning Popup ({minutes} = remaining minutes)"
                                 md:HintAssist.IsFloating="True"
                                 Text="{Binding MsgLimitWarn, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,12" />

                        <!-- Peringatan Jam Malam -->
                        <TextBox md:HintAssist.Hint="Curfew Warning Popup ({curfew_end} = time, {minutes} = remaining minutes)"
                                 md:HintAssist.IsFloating="True"
                                 Text="{Binding MsgCurfewWarn, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,12" />

                        <!-- Batas Waktu Tercapai -->
                        <TextBox md:HintAssist.Hint="Daily Limit Reached Popup (shown right before force logoff)"
                                 md:HintAssist.IsFloating="True"
                                 Text="{Binding MsgLimitReached, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,12" />

                        <!-- Jam Malam Tiba -->
                        <TextBox md:HintAssist.Hint="Curfew Reached Popup (shown right before force logoff)"
                                 md:HintAssist.IsFloating="True"
                                 Text="{Binding MsgCurfewReached, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,12" />

                        <!-- Login Ditolak - Batas Habis -->
                        <TextBox md:HintAssist.Hint="Sign-in Denied Popup — Daily Limit Reached"
                                 md:HintAssist.IsFloating="True"
                                 Text="{Binding MsgLoginDeniedLimit, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,12" />

                        <!-- Login Ditolak - Jam Malam -->
                        <TextBox md:HintAssist.Hint="Sign-in Denied Popup — Outside Schedule Hours"
                                 md:HintAssist.IsFloating="True"
                                 Text="{Binding MsgLoginDeniedCurfew, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,12" />

                        <!-- Pesan Kunci Layar -->
                        <TextBox md:HintAssist.Hint="Remote Lock Screen Warning (countdown banner before lock)"
                                 md:HintAssist.IsFloating="True"
                                 Text="{Binding MsgRemoteLock, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,12" />

                        <!-- Tambahan Waktu Diberikan -->
                        <TextBox md:HintAssist.Hint="Extra Time Approved Notification ({minutes} = minutes granted)"
                                 md:HintAssist.IsFloating="True"
                                 Text="{Binding MsgBonusGranted, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                </md:Card>

                <!-- ═══ Authenticator TOTP Security ═══ -->
                <md:ColorZone Mode="PrimaryMid" Padding="10,8" CornerRadius="4" Margin="0,0,0,8">
                    <TextBlock Text="🔐 Web Admin Authenticator 2FA (RFC 6238 TOTP)"
                               FontSize="14" FontWeight="DemiBold"
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                               VerticalAlignment="Center" />
                </md:ColorZone>

                <md:Card Padding="20" Margin="0,0,0,24" md:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <TextBlock Text="Protect the embedded Kestrel Web Admin portal (http://localhost:5050/admin) with two-factor authentication. Requires 6-digit dynamic code from Google Authenticator, Microsoft Authenticator, or 1Password to access the dashboard."
                                   TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,16" LineHeight="20" />

                        <CheckBox Content="Enable Authenticator 2FA for Web Admin (port 5050)"
                                  IsChecked="{Binding IsTotpEnabled}"
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,16" />

                        <Button Content="Generate New Authenticator Secret"
                                Command="{Binding GenerateTotpSecretCommand}"
                                HorizontalAlignment="Left"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,0,12" />

                        <TextBox md:HintAssist.Hint="Secret Key (Base32)"
                                 md:HintAssist.IsFloating="True"
                                 Text="{Binding TotpSecret, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,12" />

                        <TextBox md:HintAssist.Hint="Authenticator Setup URI (otpauth://...)"
                                 md:HintAssist.IsFloating="True"
                                 Text="{Binding TotpUri}"
                                 IsReadOnly="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,16" />

                        <StackPanel Visibility="{Binding HasQrCode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Scan this QR code with Google Authenticator, Microsoft Authenticator, or 1Password:"
                                       FontWeight="Medium" Opacity="0.8" Margin="0,0,0,8" />
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12" HorizontalAlignment="Left">
                                <Image Source="{Binding TotpQrImage}" Width="160" Height="160" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </md:Card>

                <!-- ═══ Software Updates ═══ -->
                <md:ColorZone Mode="PrimaryMid" Padding="10,8" CornerRadius="4" Margin="0,0,0,8">
                    <TextBlock Text="🚀 Software Updates &amp; Version"
                               FontSize="14" FontWeight="DemiBold"
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                               VerticalAlignment="Center" />
                </md:ColorZone>

                <md:Card Padding="20" Margin="0,0,0,24" md:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                            <TextBlock Text="Current Version:" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentVersion}" FontSize="14" FontWeight="Bold" Foreground="#0284c7" Margin="6,0,16,0" VerticalAlignment="Center" />
                            <Button Content="Check for Updates"
                                    Command="{Binding CheckForUpdatesCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </StackPanel>

                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,4,0,8"
                                     Visibility="{Binding IsCheckingUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <TextBlock Text="{Binding UpdateStatus}" FontWeight="Medium" Margin="0,4,0,4" TextWrapping="Wrap" />

                        <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,8,0,0"
                                Visibility="{Binding HasUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding ReleaseTitle}" FontWeight="Bold" FontSize="14" Foreground="#15803D" Margin="0,0,0,6" />
                                
                                <!-- Bounded scrollable changelog view -->
                                <Border Background="#FFFFFF" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding DisplayedReleaseNotes}" TextWrapping="Wrap" FontFamily="Consolas, Segoe UI, sans-serif" FontSize="12" Foreground="#1E293B" LineHeight="18" />
                                    </ScrollViewer>
                                </Border>

                                <!-- Toggle expand button -->
                                <Button Content="{Binding ChangelogToggleText}"
                                        Command="{Binding ToggleChangelogCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Padding="6,2" Height="26"
                                        HorizontalAlignment="Left"
                                        Foreground="#0284c7"
                                        FontSize="12"
                                        Margin="0,0,0,10"
                                        Visibility="{Binding HasMoreChangelog, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <Button Content="Download &amp; Install Update"
                                        Command="{Binding ApplyUpdateCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        HorizontalAlignment="Left"
                                        Background="#16A34A" BorderBrush="#16A34A" />

                                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsInstallingUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ProgressBar Height="6" Value="{Binding DownloadProgress}" Maximum="100" IsIndeterminate="{Binding IsProgressIndeterminate}" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding UpdateStatus}" FontSize="11" Opacity="0.75" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </md:Card>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ Sticky Bottom Save Bar (Always Fully Visible) ═══ -->
        <Border DockPanel.Dock="Bottom" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Save All Settings"
                        Command="{Binding SaveSettingsCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        HorizontalAlignment="Left"
                        Height="40" Padding="32,0" />
                <TextBlock Text="Perubahan konfigurasi langsung berlaku ke sistem."
                           VerticalAlignment="Center" Margin="16,0,0,0" Opacity="0.6" FontSize="12" />
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>
